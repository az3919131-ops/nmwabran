# انسخ هذا الملف إلى .env وعدّل القيم. لا أسرار في الكود: كل شيء من هنا.
# docker compose يقرأ هذا الملف تلقائيًا؛ وللتشغيل المحلي بلا docker يقرؤه الخادم (npm run dev:api).

# ───────────── البيئة ─────────────
NODE_ENV=development
# توقيت الخادم: يحدد معنى جداول الإرسال (cron) في «قوائم البريد»
TZ=Asia/Riyadh

# ───────────── قاعدة البيانات ─────────────
POSTGRES_PASSWORD=iltizam
# للتشغيل المحلي بلا docker (في docker يُبنى الرابط تلقائيًا)
DATABASE_URL=postgresql://iltizam:iltizam@localhost:5432/iltizam

# ───────────── الأمان ─────────────
# طويلة وعشوائية في الإنتاج (الخادم يرفض القيمة الافتراضية عند NODE_ENV=production)
JWT_SECRET=change-me
WEBHOOK_SECRET=change-me
# true خلف HTTPS
COOKIE_SECURE=false

# ───────────── الواجهة ─────────────
APP_BASE_URL=http://localhost:5173
# يُستخدم لتوليد PDF: عنوان الواجهة كما يراه Chromium داخل الخادم (docker: http://web:5173)
PDF_RENDER_BASE_URL=http://localhost:5173
# تعطيل توليد PDF (يبقى Excel) إن لم يتوفر Chromium
DISABLE_PDF=false
CHROMIUM_PATH=

# ───────────── البريد (الإرسال من الخادم فقط — لا مفاتيح في الواجهة) ─────────────
# smtp | resend | gmail_api
MAIL_PROVIDER=smtp
# SMTP: في docker الافتراضي MailHog (mailhog:1025) وصندوقه http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="محفظة الالتزام <no-reply@example.com>"
# Resend
RESEND_API_KEY=
# Gmail API (OAuth2 بـ refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# مستلم إلزامي لكل تقرير — لا يُحذف ولا يُعطَّل من الواجهة ولا من الـ API
ADMIN_EMAIL=az3919131@gmail.com
# المرفقات الأكبر من هذا الحد تتحول إلى رابط تنزيل موقّع صالح 7 أيام
REPORT_MAX_ATTACH_MB=15

# ───────────── التخزين ─────────────
# local | s3
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ───────────── محفظة Ai (Claude على الخادم) ─────────────
# بدونه تعمل المنصة كاملة بمحرك الاستنباط، ويعتذر المساعد برسالة واضحة
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ───────────── المستخدمون الأوليون ─────────────
# تُنشأ مرة واحدة عند أول إقلاع (ahmed مدير النظام، salem مدير قسم، hamad مدير مشاريع). غيّرها قبل أي استخدام حقيقي.
SEED_ADMIN_USER=ahmed
SEED_ADMIN_PASSWORD=
SEED_DEPT_PASSWORD=
SEED_PM_PASSWORD=
# يزرع مشروع «تحويل طريق الحصينية» التجريبي
SEED_DEMO_DATA=true

# ───────────── الطابور ─────────────
# pg-boss: 3 محاولات بتأخير متزايد لإرسال التقارير والـ webhooks
QUEUE_ENABLED=true
